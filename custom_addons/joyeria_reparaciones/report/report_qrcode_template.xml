<odoo>
  <template id="report_qr_code_document">
    <t t-call="web.html_container">
      <!-- Formato 80mm x 100mm (altura mínima, ajustable) -->
      <t t-set="report_paperformat" t-value="{
          'format': [80, 100],
          'orientation': 'Portrait',
          'margin_top': 2,
          'margin_bottom': 2,
          'margin_left': 2,
          'margin_right': 2
      }"/>
      <t t-foreach="docs" t-as="o">
        <!-- Mantengo fuente 12px, ajusto line-height y margen para que todo quede alineado -->
        <div class="page" style="font-size:12px; text-align:left; line-height:1.2;">
          <style>
            .qr-line { margin: 2px 0; }
            .qr-title { font-size:15px; font-weight:bold; margin: 4px 0; text-align:center; }
            .qr-sep { text-align:center; margin: 2px 0; }
          </style>

          <p class="qr-sep">************************</p>

          <!-- RMA centrado -->
          <p class="qr-title"><t t-esc="o.name"/></p>

          <p class="qr-sep">************************</p>

          <p class="qr-line"><strong>Local:</strong> <t t-esc="o.local_tienda"/></p>
          <!-- Cliente en UNA sola línea -->
          <p class="qr-line"><strong>Cliente:</strong> <t t-esc="(o.cliente_id.name or '') + ' ' + (o.apellido_cliente or '')"/></p>
          <p class="qr-line"><strong>Servicio:</strong> <t t-esc="o.servicio"/></p>
          <p class="qr-line"><strong>Metal:</strong> <t t-esc="o.metal"/></p>
          <p class="qr-line"><strong>Modelo:</strong> <t t-esc="o.modelo"/></p>

          <t t-if="o.n_cm_reparacion">
            <p class="qr-line"><strong>Talla Reparacion:</strong> <t t-esc="o.n_cm_reparacion"/></p>
          </t>
          <t t-if="o.n_cm_fabricacion">
            <p class="qr-line"><strong>Talla Fabricacion:</strong> <t t-esc="o.n_cm_fabricacion"/></p>
          </t>

          <p class="qr-line"><strong>Precio:</strong> <t t-esc="o.precio_unitario"/></p>
          <p class="qr-line"><strong>Abono:</strong> <t t-esc="o.abono"/></p>
          <p class="qr-line"><strong>Saldo:</strong> <t t-esc="o.saldo"/></p>
          <p class="qr-line"><strong>Ingreso:</strong> <t t-esc="o.fecha_recepcion"/></p>
          <p class="qr-line"><strong>Entrega:</strong> <t t-esc="o.fecha_entrega"/></p>
          <p class="qr-line"><strong>Garantia:</strong> <t t-esc="o.vencimiento_garantia or ''"/></p>

          <p class="qr-line" style="text-align:justify;">
            Joyeria Sebastian no asumira responsabilidad por trabajos no retirados pasados 90 dias desde la fecha pactada para su entrega.
          </p>

          <div style="margin-top:6px; text-align:center;">
            <img t-if="o.qr" t-att-src="'data:image/png;base64,%s' % o.qr.decode('utf-8')" width="100" height="100"/>
          </div>

          <p class="qr-sep">************************</p>
        </div>
      </t>
    </t>
  </template>
</odoo>
