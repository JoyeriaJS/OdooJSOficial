<odoo>
  <template id="report_qr_code_document">
    <t t-call="web.html_container">
      <!-- 80 x 100 mm -->
      <t t-set="report_paperformat" t-value="{
          'format': [80, 100],
          'orientation': 'Portrait',
          'margin_top': 2,
          'margin_bottom': 2,
          'margin_left': 2,
          'margin_right': 2
      }"/>
      <t t-foreach="docs" t-as="o">
        <!-- Compactación: menos margen entre líneas y bloques -->
        <div class="page" style="font-size:12px; text-align:center; line-height:1.2;">
          <style type="text/css">
            .qr-ticket p { margin: 0 0 2px 0; }           /* filas más pegadas */
            .qr-ticket .sep { margin: 2px 0; }            /* asteriscos compactos */
            .qr-ticket .title { font-size:19px; margin: 3px 0; }
            .qr-ticket .label { font-weight:bold; }
          </style>

          <div class="qr-ticket">
            <p class="sep">************************</p>

            <!-- RMA (título) -->
            <p class="title"><t t-esc="o.name"/></p>

            <p class="sep">************************</p>

            <p><span class="label">Local:</span> <t t-esc="o.local_tienda"/></p>

            <!-- Cliente en UNA sola línea (sin <br/>) -->
            <p><span class="label">Cliente:</span>
              <t t-esc="(o.cliente_id.name or '') + ' ' + (o.apellido_cliente or '')"/>
            </p>

            <p><span class="label">Servicio:</span> <t t-esc="o.servicio"/></p>
            <p><span class="label">Metal:</span> <t t-esc="o.metal"/></p>
            <p><span class="label">Modelo:</span> <t t-esc="o.modelo"/></p>

            <t t-if="o.n_cm_reparacion">
              <p><span class="label">Talla Reparacion:</span> <t t-esc="o.n_cm_reparacion"/></p>
            </t>
            <t t-if="o.n_cm_fabricacion">
              <p><span class="label">Talla Fabricacion:</span> <t t-esc="o.n_cm_fabricacion"/></p>
            </t>

            <p><span class="label">Precio:</span> <t t-esc="o.precio_unitario"/></p>
            <p><span class="label">Abono:</span> <t t-esc="o.abono"/></p>
            <p><span class="label">Saldo:</span> <t t-esc="o.saldo"/></p>
            <p><span class="label">Ingreso:</span> <t t-esc="o.fecha_recepcion"/></p>
            <p><span class="label">Entrega:</span> <t t-esc="o.fecha_entrega"/></p>
            <p><span class="label">Garantia:</span> <t t-esc="o.vencimiento_garantia or ''"/></p>

            <!-- Aviso legal más compacto (mismas palabras) -->
            <p style="margin-top:2px;">
              Joyeria Sebastian no asumira responsabilidad por trabajos no retirados
              pasados 90 dias desde la fecha pactada para su entrega.
            </p>

            <div style="margin-top:6px; text-align:center;">
              <img t-if="o.qr" t-att-src="'data:image/png;base64,%s' % o.qr.decode('utf-8')" width="100" height="100"/>
            </div>

            <p class="sep">************************</p>
          </div>
        </div>
      </t>
    </t>
  </template>
</odoo>
